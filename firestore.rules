rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /games/{code} {
      function base()         { return /databases/$(database)/documents/games/$(code); }
      function gameDoc()      { return get(base()).data; }
      function isGM()         { return signedIn() && (exists(/databases/$(database)/documents/games/$(code)/gmDevices/$(request.auth.uid))
                                                      || gameDoc().gmUid == request.auth.uid); }
      function claimPath(pid) { return /databases/$(database)/documents/games/$(code)/claims/$(pid); }
      function isPlayer(pid)  { return signedIn() && exists(claimPath(pid)) && get(claimPath(pid)).data.uid == request.auth.uid; }

      // Public game board
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid;
      allow update: if isGM() && request.resource.data.gmUid == resource.data.gmUid;
      allow delete: if isGM();

      // GM password (stored only as a hash in the document ID; never readable)
      match /gmAccess/{key} {
        allow read: if false;
        allow create: if signedIn() && (gameDoc().gmUid == request.auth.uid || isGM());
        allow update: if false;
        allow delete: if isGM();
      }

      // Devices unlocked with the GM password
      match /gmDevices/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isGM();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.key is string
          && exists(/databases/$(database)/documents/games/$(code)/gmAccess/$(request.resource.data.key));
        allow delete: if signedIn() && (request.auth.uid == uid || isGM());
      }

      // Game Master's secret sheet
      match /gm/{docId} {
        allow read, write: if isGM();
      }

      // Each player's private dossier
      match /private/{key} {
        allow get: if true;
        allow list: if false;
        allow create, delete: if isGM();
        allow update: if isGM()
          || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['offerResponse', 'seenRole', 'noticeSeen']));
      }

      // Device to player binding
      match /claims/{pid} {
        allow read: if isGM() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.key is string
          && get(/databases/$(database)/documents/games/$(code)/private/$(request.resource.data.key)).data.playerId == pid;
        allow delete: if isGM();
      }

      // Secret ballots
      match /votes/{voteDocId} {
        allow read, delete: if isGM();
        allow create, update: if isPlayer(request.resource.data.voter)
          && gameDoc().vote.open == true
          && request.resource.data.voteId == gameDoc().vote.id
          && voteDocId == gameDoc().vote.id + '_' + request.resource.data.voter
          && request.resource.data.voter in gameDoc().vote.voters;
      }

      // The Traitors' room
      match /chamber/{key} {
        allow get, create, update: if signedIn();
        allow list, delete: if false;

        match /messages/{msgId} {
          allow read, create: if signedIn();
          allow update, delete: if isGM();
        }
        match /nominations/{pid} {
          allow read, write: if signedIn();
        }
      }
    }
  }
}
