rules_version = '2';

// =====================================================================
//  THE TRAITORS — Firestore security rules
//  Paste into Firebase Console → Firestore Database → Rules → Publish
//
//  Security model
//  • games/{code}                 public board (no secrets). Only the GM (creator uid) can write.
//  • games/{code}/gm/secret       roles, PINs, keys, shields, daggers → GM only.
//  • games/{code}/private/{key}   one doc per player; doc id = SHA-256(code|playerId|PIN).
//                                 Can be READ by id (get) but never LISTED, so only the
//                                 PIN holder (and the GM) can find it.
//  • games/{code}/claims/{pid}    binds a device (anonymous uid) to a player, only allowed
//                                 if the device proves it knows that player's private key.
//  • games/{code}/votes/{id}      players write only their own vote, only while voting is
//                                 open, only if they are an eligible voter. GM-only reads.
//  • games/{code}/chamber/{key}   the Traitors' Turret; key is a random 128-bit secret
//                                 given only to Traitors. Cannot be listed.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /games/{code} {
      function gameDoc()      { return get(/databases/$(database)/documents/games/$(code)).data; }
      function isGM()         { return signedIn() && gameDoc().gmUid == request.auth.uid; }
      function claimPath(pid) { return /databases/$(database)/documents/games/$(code)/claims/$(pid); }
      function isPlayer(pid)  { return signedIn() && exists(claimPath(pid)) && get(claimPath(pid)).data.uid == request.auth.uid; }

      // Public game board
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid;
      allow update: if signedIn() && resource.data.gmUid == request.auth.uid
                    && request.resource.data.gmUid == resource.data.gmUid;
      allow delete: if signedIn() && resource.data.gmUid == request.auth.uid;

      // Game Master's secret sheet
      match /gm/{docId} {
        allow read, write: if isGM();
      }

      // Each player's private dossier (role, shield, dagger, offers…)
      match /private/{key} {
        allow get: if true;
        allow list: if false;
        allow create, delete: if isGM();
        allow update: if isGM()
          || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['offerResponse', 'seenRole', 'noticeSeen']));
      }

      // Device ↔ player binding
      match /claims/{pid} {
        allow read: if isGM() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.key is string
          && get(/databases/$(database)/documents/games/$(code)/private/$(request.resource.data.key)).data.playerId == pid;
        allow delete: if isGM();
      }

      // Secret ballots
      match /votes/{voteDocId} {
        allow read, delete: if isGM();
        allow create, update: if isPlayer(request.resource.data.voter)
          && gameDoc().vote.open == true
          && request.resource.data.voteId == gameDoc().vote.id
          && voteDocId == gameDoc().vote.id + '_' + request.resource.data.voter
          && request.resource.data.voter in gameDoc().vote.voters;
      }

      // The Traitors' Turret (knowing the secret key = access)
      match /chamber/{key} {
        allow get, create, update: if signedIn();
        allow list, delete: if false;

        match /messages/{msgId} {
          allow read, create: if signedIn();
          allow update, delete: if isGM();
        }
        match /nominations/{pid} {
          allow read, write: if signedIn();
        }
      }
    }
  }
}
